# ./gradlew initLocalEnv가 개인 개발값을 .env에 생성한다. 실제 값은 커밋하지 않는다.
DB_USER=iseonjwa
DB_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PAYMENT_TOKEN_SECRET=
ENTRY_TOKEN_SECRET=
BILLING_KEY_SECRET=
ADMIN_EMAIL=admin@iseonjwa.local
ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# 선택: 슬랙 #이선좌-성능-모니터링 웹훅. 비우면 알림을 슬랙으로 보내지 않는다. 확인할 때만 넣는다.
# 값을 바꾼 뒤에는 docker compose up -d --force-recreate alertmanager 로 다시 만들어야 반영된다.
SLACK_WEBHOOK_MONITORING=
# 선택: 알림 제목에 붙는 환경 이름. 비우면 local, 배포 서버는 deploy
STACK_ENV=
# 선택: 결제 PG. 비우면 mock이다. toss는 시연 때만 켠다(진행 중인 결제가 없을 때만 바꾸고, 부하 측정은 늘 mock).
# toss를 고르면 토스 테스트 키(test_sk_, test_ck_로 시작)가 필요하다. 라이브 키는 기동에 실패한다. 값은 커밋하지 않는다.
PAYMENT_PG_PROVIDER=
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
# 선택: 내부 AI 상담(assistant-service, ISE-126)이 Claude를 부를 때 쓰는 Anthropic API 키.
# 비우면 Claude를 부르지 않고 검색 모드로만 답한다. 키는 이 파일에만 두고 저장소·채팅에 붙이지 않는다.
ANTHROPIC_API_KEY=
