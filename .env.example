# 이 파일을 복사해 .env를 만들고 값을 바꾼다: cp .env.example .env
# .env는 .gitignore에 있다. 실제 값은 저장소·채팅·PR에 올리지 않는다
# 값이 비어 있으면 docker compose가 기동을 멈추고 어떤 변수가 빠졌는지 알려 준다

# PostgreSQL (서비스마다 DB·계정이 따로 있다)
USER_DB_PASSWORD=change-me-user
RESERVATION_DB_PASSWORD=change-me-reservation
PAYMENT_DB_PASSWORD=change-me-payment

# Grafana 관리자 (계정명은 admin)
GRAFANA_ADMIN_PASSWORD=change-me-grafana
