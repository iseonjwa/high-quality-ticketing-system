# 이 파일을 .env로 복사하고 값을 채운다. .env는 커밋하지 않는다 (SA 9-1)
#   cp .env.example .env
# compose는 .env를 자동으로 읽고, IntelliJ로 띄운 gateway·user-service도 이 파일을 읽는다

# Access 토큰 서명 키. Base64로 인코딩한 32바이트 이상 값이고 gateway와 user-service가 같은 값을 쓴다
#   만들기: openssl rand -base64 32
JWT_SECRET=

# 입장 토큰(Reservation 발급 → Gateway 검증), 결제 토큰(Reservation 발급 → Payment 검증) 서명 키 (SA 7-3)
# 서로 다른 값을 쓴다. 대기열·결제 기능을 만들 때 사용한다
ENTRY_TOKEN_SECRET=
PAYMENT_TOKEN_SECRET=

# 서비스별 PostgreSQL 비밀번호 (SA 9-1: DB 3개)
USER_DB_PASSWORD=
RESERVATION_DB_PASSWORD=
PAYMENT_DB_PASSWORD=

# Grafana 관리자 비밀번호 (계정 admin)
GRAFANA_ADMIN_PASSWORD=
