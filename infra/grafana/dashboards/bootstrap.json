{
  "uid": "iseonjwa-bootstrap",
  "title": "이선좌 개발 기반",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP 요청률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 오류율",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM 사용 메모리",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (application) (jvm_memory_used_bytes)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "인증 Redis 서킷 상태",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{name=\"auth-redis\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Gateway 동시 처리 수와 상한",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (application) (gateway_in_flight_requests{application=\"gateway\"})",
          "legendFormat": "처리 중",
          "refId": "A"
        },
        {
          "expr": "max by (application) (gateway_in_flight_limit{application=\"gateway\"})",
          "legendFormat": "상한",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Gateway 동시 처리 수 상한 거절률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "상한 거절은 서버 관측보다 앞에서 일어나 http_server_requests에 들어가지 않는다. 분모는 관측된 요청 수 + 거절 수다. 경보 GatewayInFlightRejecting(5분 1%), GatewayInFlightRejectingPeak(1분 1%)",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(gateway_in_flight_rejected_total{application=\"gateway\"}[1m])) / (sum by (application) (rate(http_server_requests_seconds_count{application=\"gateway\"}[1m])) + sum by (application) (rate(gateway_in_flight_rejected_total{application=\"gateway\"}[1m])))",
          "legendFormat": "거절률(1분)",
          "refId": "A"
        }
      ]
    }
  ]
}
