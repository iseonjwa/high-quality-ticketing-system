{
  "uid": "iseonjwa-lottery",
  "title": "추첨",
  "tags": [
    "lottery"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "editable": true,
  "description": "추첨 흐름 관측(ISE-94). 기준은 docs/design/lottery/numbers-and-measurement.md",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "지금 울리는 추첨 알림",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "추첨 알림(Prometheus ALERTS)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{service=\"lottery\"}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "service": true,
              "application": true
            },
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "alertstate": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "진행 상태(종결 스케줄러가 1분마다 갱신)",
