{
  "uid": "iseonjwa-payment",
  "title": "결제",
  "tags": [
    "payment"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "editable": true,
  "description": "결제 서비스 관측(docs/design/payment/observability.md 3절). 알림 규칙은 infra/prometheus/rules/payment-alerts.yml",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "지금 울리는 결제 알림",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "결제 알림(Prometheus ALERTS)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{service=\"payment\"}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "service": true,
              "application": true
            },
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "alertstate": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "infra/prometheus/rules/payment-alerts.yml의 규칙 중 pending·firing인 것. 복구 절차는 각 규칙의 runbook(manual-recovery.md)이다"
    },
    {
      "id": 3,
      "type": "row",
      "title": "1. 돈이 걸린 미해결",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "결제 NMC",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "payment_manual_check_count{application=\"payment-service\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "NEEDS_MANUAL_CHECK 결제 건수. 0보다 크면 즉시 확인"
    },
