    {
      "title": "결제 대시보드",
      "type": "link",
      "url": "/d/iseonjwa-payment",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "traceId",
        "label": "traceId",
        "description": "응답 본문의 traceId(32자 16진). 로그 줄 [traceId-spanId]의 앞 32자와 같다",
        "query": "",
        "current": {
          "text": "",
          "value": ""
