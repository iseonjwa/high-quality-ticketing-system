{
  "uid": "iseonjwa-seathold",
  "title": "좌석 선점",
  "tags": [
    "seathold"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "editable": true,
  "description": "좌석 선점, 회차 좌석·공연 조회, 접수형 결과 폴링의 서버 쪽 지연과 선점 결과(ISE-277)",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "좌석 선점 POST /api/v1/schedules/{scheduleId}/reservations",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "선점 서버 지연(p50·p95·p99)",
      "description": "서버가 요청을 받아 응답을 쓸 때까지다. Gateway·네트워크 시간은 빠진다. 버킷 경계(25ms~3s) 사이는 선형으로 어림한 값이다(config-repo/reservation-service.yml)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"reservation-service\",uri=\"/api/v1/schedules/{scheduleId}/reservations\",method=\"POST\"}[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"reservation-service\",uri=\"/api/v1/schedules/{scheduleId}/reservations\",method=\"POST\"}[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"reservation-service\",uri=\"/api/v1/schedules/{scheduleId}/reservations\",method=\"POST\"}[1m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "선점 결과별 초당 응답",
      "description": "seathold.result 카운터(ISE-277). held=동기형 201, accepted=접수형 202, 나머지는 거절 이유다. 컨트롤러 전에 끝난 400과 접수형 소비자의 결과는 들어가지 않는다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(seathold_result_total{application=\"reservation-service\"}[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "선점 300ms 안 응답 비율",
      "description": "상태 코드와 상관없이 300ms 안에 응답한 선점 요청의 비율이다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_bucket{application=\"reservation-service\",uri=\"/api/v1/schedules/{scheduleId}/reservations\",method=\"POST\",le=\"0.3\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"reservation-service\",uri=\"/api/v1/schedules/{scheduleId}/reservations\",method=\"POST\"}[1m]))",
          "legendFormat": "300ms 이내",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "선점 거절 중 좌석 충돌 비율",
      "description": "업무 거절(held·accepted·error를 뺀 결과) 중 seat_conflict의 비율이다",
