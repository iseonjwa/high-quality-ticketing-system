          "expr": "sum(rate(seathold_result_total{application=\"reservation-service\",outcome=\"seat_conflict\"}[1m])) / sum(rate(seathold_result_total{application=\"reservation-service\",outcome!~\"held|accepted|error\"}[1m]))",
          "legendFormat": "좌석 충돌",
