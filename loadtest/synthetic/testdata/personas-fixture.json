{
  "version": 1,
  "description": "테스트 전용 픽스처. 실제 부하 측정에 쓰지 않는다. 도구 단위 테스트가 모든 분포 종류와 규칙(refresh_s·queue_patience_s 올림)을 지나가게 만든 값이다.",
  "personas": [
    {
      "code": "waiting_fan",
      "name_ko": "대기 팬",
      "share": 0.4,
      "description": "테스트 전용 픽스처. 오픈 전부터 상세를 새로고침하다 오픈 직후 한 번 진입한다.",
      "fields": {
        "arrive_s": {"dist": "uniform", "min": -600, "max": -60},
        "refresh_s": {"dist": "uniform", "min": 1, "max": 20},
        "enter_delay_ms": {"dist": "exponential", "mean": 800, "min": 0, "max": 5000},
        "enter_clicks": {"dist": "choice", "values": [1, 2], "weights": [0.8, 0.2]},
        "seats": {"dist": "choice", "values": [1, 2], "weights": [0.5, 0.5]},
        "zone": {"dist": "choice", "values": ["VIP", "R", "S", "ANY"], "weights": [0.3, 0.4, 0.2, 0.1]},
        "think_ms": {"dist": "normal", "mean": 3000, "sd": 1500, "min": 300, "max": 15000},
        "max_retry": {"dist": "const", "value": 2},
        "on_conflict": {"dist": "choice", "values": ["same_zone", "any_zone"], "weights": [0.6, 0.4]},
        "queue_patience_s": {"dist": "const", "value": 0},
        "abandon_after_hold": {"dist": "bernoulli", "p": 0.1},
        "pay_delay_s": {"dist": "uniform", "min": 10, "max": 60}
      },
      "basis": "테스트 전용 값. 실제 근거 없음."
    },
    {
      "code": "pair_buyer",
      "name_ko": "2매 구매자",
      "share": 0.3,
      "description": "테스트 전용 픽스처. 친구와 2매를 잡으려는 사람.",
      "fields": {
        "arrive_s": {"dist": "const", "value": -120},
        "refresh_s": {"dist": "const", "value": 10},
        "enter_delay_ms": {"dist": "uniform", "min": 0, "max": 3000},
        "enter_clicks": {"dist": "const", "value": 1},
        "seats": {"dist": "const", "value": 2},
        "zone": {"dist": "choice", "values": ["R", "S"], "weights": [0.5, 0.5]},
        "think_ms": {"dist": "uniform", "min": 1000, "max": 8000},
        "max_retry": {"dist": "choice", "values": [1, 3], "weights": [0.5, 0.5]},
        "on_conflict": {"dist": "const", "value": "any_zone"},
        "queue_patience_s": {"dist": "uniform", "min": 1, "max": 120},
        "abandon_after_hold": {"dist": "const", "value": 0},
        "pay_delay_s": {"dist": "normal", "mean": 30, "sd": 10, "min": 5, "max": 120}
      },
      "basis": "테스트 전용 값. 실제 근거 없음."
    },
    {
      "code": "late_arrival",
      "name_ko": "늦은 접속자",
      "share": 0.2,
      "description": "테스트 전용 픽스처. 오픈 뒤에 접속해 상세를 한 번 보고 진입한다.",
      "fields": {
        "arrive_s": {"dist": "uniform", "min": 5, "max": 300},
        "refresh_s": {"dist": "const", "value": 0},
        "enter_delay_ms": {"dist": "uniform", "min": 500, "max": 4000},
        "enter_clicks": {"dist": "choice", "values": [1, 3], "weights": [0.9, 0.1]},
        "seats": {"dist": "choice", "values": [1, 2, 3, 4], "weights": [0.4, 0.3, 0.2, 0.1]},
        "zone": {"dist": "const", "value": "ANY"},
        "think_ms": {"dist": "uniform", "min": 500, "max": 5000},
        "max_retry": {"dist": "const", "value": 0},
        "on_conflict": {"dist": "const", "value": "give_up"},
        "queue_patience_s": {"dist": "choice", "values": [0, 60], "weights": [0.7, 0.3]},
        "abandon_after_hold": {"dist": "bernoulli", "p": 0.3},
        "pay_delay_s": {"dist": "uniform", "min": 5, "max": 40}
      },
      "basis": "테스트 전용 값. 실제 근거 없음."
    },
    {
      "code": "browser_only",
      "name_ko": "구경만 하는 사람",
      "share": 0.1,
      "description": "테스트 전용 픽스처. 상세만 보다 진입하지 않고 떠난다.",
      "fields": {
        "arrive_s": {"dist": "uniform", "min": -300, "max": 0},
        "refresh_s": {"dist": "const", "value": 15},
        "enter_delay_ms": {"dist": "const", "value": 0},
        "enter_clicks": {"dist": "const", "value": 0},
        "seats": {"dist": "const", "value": 1},
        "zone": {"dist": "const", "value": "ANY"},
        "think_ms": {"dist": "const", "value": 1000},
        "max_retry": {"dist": "const", "value": 0},
        "on_conflict": {"dist": "const", "value": "give_up"},
        "queue_patience_s": {"dist": "const", "value": 0},
        "abandon_after_hold": {"dist": "const", "value": 0},
        "pay_delay_s": {"dist": "const", "value": 10}
      },
      "basis": "테스트 전용 값. 실제 근거 없음."
    }
  ],
  "assumptions": ["테스트 전용이라 근거 없는 값이다"]
}
